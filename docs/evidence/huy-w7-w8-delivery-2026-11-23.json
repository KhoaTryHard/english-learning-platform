  "outboxRelayReconciliation": {
    "situation": "PR #43 already contained OutboxRelay.java, EventPublisher.java, OutboxKafkaConfiguration.java and OutboxKafkaWiringTest.java. An earlier independent implementation in this session was discarded in favour of merging onto the PR #43 design.",
    "keptFromPR43": [
      "EventPublisher as the transport abstraction, so tests need no KafkaTemplate subclass",
      "OutboxKafkaConfiguration bean wiring gated on assessment.kafka.enabled, with the scheduled RelayJob",
      "public int runBatch(int limit) signature and the 1..100 limit validation",
      "Both existing relay tests in AssessmentServiceTest and OutboxKafkaWiringTest, unchanged and still passing"
    ],
    "changedFromPR43": [
      {
        "change": "Removed @Transactional from runBatch and dropped FOR UPDATE SKIP LOCKED",
        "reason": "W7-06 requires the relay to publish outside the transaction. In PR #43 the broker call ran inside an open transaction holding row locks and a pooled connection for up to batch-size times the send timeout, and a mid-batch database failure discarded the retry bookkeeping for the whole batch.",
        "tradeOff": "Without row locks two relay instances may publish the same event twice. Safe under at-least-once delivery with consumer deduplication on processed_event, and preferred over holding broker I/O inside a database transaction."
      },
      {
        "change": "Mark-SENT and retry updates are guarded with AND status='PENDING'",
        "reason": "Makes each update idempotent and makes the returned count the number of real PENDING to SENT transitions."
      },
      {
        "change": "last_error records the exception type and message instead of the constant 'PUBLISH_FAILED'",
        "reason": "W7-06 asks for retry/recovery evidence; a constant flag carries no diagnostic. Truncated to 1000 characters."
      },
      {
        "change": "A failed publish blocks only the remaining events of that same partition key; other keys keep draining",
        "reason": "PR #43 used continue, which could publish a later event of the same user before an earlier failed one, breaking per-key order. A plain break would let one undeliverable event block every learner. Skipping per key preserves the ordering Kafka actually guarantees without a global stall."
      },
      {
        "change": "Added a Clock-based backlogAgeSeconds() and made batch size and send timeout configurable via assessment.kafka.*",
        "reason": "Observability for the relay backlog and tunable sweeps without a rebuild."
      }
    ],
    "compatibilityEvidence": "AssessmentServiceTest.relayFailureRetainsEventAndRetryUsesSamePayload, AssessmentServiceTest.crashWindowAfterPublishReplaysStableEventId and OutboxKafkaWiringTest are PR #43 tests kept verbatim and pass against the merged relay."
  },
