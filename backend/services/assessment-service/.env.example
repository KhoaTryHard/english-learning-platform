DB_PASSWORD=replace-with-a-local-password
DB_USER=assessment
DB_PORT=5543
PORT=8090
USER_URL=http://host.docker.internal:8081
CONTENT_URL=http://host.docker.internal:8082
# Read-only directory containing api.public.pem, user.public.pem,
# content.public.pem, progress.public.pem. Never copy another service's private key.
PUBLIC_KEYS_DIR=./.secrets/public
PRIVATE_KEY_FILE=./.secrets/assessment.private.pem

KAFKA_ENABLED=false
KAFKA_BOOTSTRAP_SERVERS=host.docker.internal:9092
